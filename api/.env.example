# Environment Configuration
# Copy this file to .env and fill in your database credentials.
# On OVH, find these in: Control Panel > Web Hosting > Databases

# Application
APP_ENV=development
CORS_ORIGIN=*

# Database (MySQL local / Docker)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crenelio
DB_USER=crenelio
DB_PASS=crenelio_dev
DB_CHARSET=utf8mb4

# URL publique du site — sert à construire le lien de gestion envoyé au client
APP_URL=https://votre-domaine.com
# Fuseau de référence de l'artisan : les datetimes en base et les .ics s'y interprètent
APP_TIMEZONE=Europe/Paris

# Envoi d'emails (SMTP) — jamais stocké en base
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=contact@votre-domaine.com
SMTP_PASS=
# starttls (port 587, recommandé), tls (port 465, TLS implicite) ou none
SMTP_SECURE=starttls
MAIL_FROM=contact@votre-domaine.com
MAIL_FROM_NAME=Crénelio