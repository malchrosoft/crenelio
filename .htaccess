# OVH Hosting Root .htaccess
# Place this in the www/ directory on your OVH hosting.

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route /api/* requests to the PHP front controller.
    # Everything under /api is handled by api/index.php
    RewriteRule ^api/? api/index.php [QSA,L]

    # Bundle compilé (JS, CSS) : /assets/<fichier> → api/public/assets/<fichier>
    # (Vite compile avec base '/assets/', cf. vite.config.js)
    RewriteRule ^assets/(.+)$ api/public/assets/$1 [L]

    # Page d'accueil et routes de la SPA (/booking, /admin, /rdv/…) : index.html COMPILÉ.
    # Le index.html de la racine du dépôt est la source de développement Vite : jamais servi.
    RewriteRule ^(index\.html)?$ api/public/assets/index.html [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ api/public/assets/index.html [L]
</IfModule>

# Security: hide sensitive files
<FilesMatch "^\.(env|git|htaccess|ovhconfig)$">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes
