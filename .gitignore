# Dependencies
node_modules/
vendor/

# Build output (generated, not committed)
api/public/assets/

# Logo & favicon propres à chaque installation
api/storage/branding/*
!api/storage/branding/.gitkeep
# Attestation d'assurance décennale du professionnel (Item 22)
api/storage/insurance/*
!api/storage/insurance/.gitkeep
api/storage/zone/*
!api/storage/zone/.gitkeep
# Clé de signature et compteur d'échecs de connexion (Item 12)
api/storage/auth/*
!api/storage/auth/.gitkeep

# Paquets et réponses de npm run deploy:init (contiennent api/.env)
/deploy/
/.deploy/
# Archives de npm run release (Item 28)
/release/

# Environment & secrets
# Ignore ALL .env* files EXCEPT api/.env.example
.env*
!/api/.env.example

# IDE specific files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Python
__pycache__/

# Dépôt des textes officiels à lire (Légifrance, PDF volumineux) : seuls les extraits
# reportés dans docs/legal/fr/textes/ sont versionnés
/docs/legal/textes-officiels/*
!/docs/legal/textes-officiels/A-DEPOSER.md
