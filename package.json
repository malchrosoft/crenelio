{
  "name": "crenelio",
  "version": "0.0.1",
  "description": "Lightweight React + PHP REST API + MySQL boilerplate for OVHcloud shared hosting",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "start": "node scripts/run-python.mts scripts/start.py",
    "stop": "node scripts/run-python.mts scripts/stop.py",
    "ouvrir": "node scripts/ouvrir.mts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "deploy:build": "node scripts/build.mts",
    "deploy:init": "node scripts/deploy-init.mts",
    "release": "node scripts/release.mts"
  },
  "dependencies": {
    "@ag-grid-community/locale": "^36.2.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@phosphor-icons/react": "^2.1.10",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "pigeon-maps": "^0.22.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.11"
  }
}
